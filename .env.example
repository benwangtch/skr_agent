# Copy to .env and fill in. Every IO service this codebase talks to is
# configured here — nothing else should need a code change to move from a
# laptop to the real company environment. See src/skr_agent/config/.

# ---------------------------------------------------------------------------
# LLM (src/skr_agent/config/llm.py) — which backend the Claude Agent SDK's
# CLI subprocess talks to for every agent turn.
# ---------------------------------------------------------------------------

# "openrouter" (default) | "anthropic" | "custom"
LLM_PROVIDER=openrouter

# --- provider=openrouter: simulating an internal host with OpenRouter ------
# 1. Get a key at https://openrouter.ai/keys — it looks like sk-or-v1-...
# 2. Set it here. LLM_BASE_URL and LLM_MODEL already default correctly for
#    this provider (openrouter.ai/api + qwen/qwen3.5-plus-02-15) — you only
#    need to set the key to get a working agent.
LLM_API_KEY=sk-or-v1-REPLACE_ME

# Optional: pick a different Qwen 3.5 tier. Flash is cheaper/faster, Plus is
# the stronger default above.
# LLM_MODEL=qwen/qwen3.5-flash-02-23

# --- provider=anthropic: the real Anthropic API -----------------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# (LLM_MODEL defaults to claude-opus-5 for this provider; override to pin
# another Claude model.)

# --- provider=custom: an internal host that speaks the Anthropic Messages
# wire protocol (not just an OpenAI-compatible one — see config/llm.py's
# docstring for why that distinction matters) --------------------------------
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://llm.internal.corp/anthropic
# LLM_API_KEY=whatever-internal-auth-issues
# LLM_MODEL=whatever-the-internal-host-calls-its-model

# Reasoning depth for every agent that doesn't set its own effort: low |
# medium | high | xhigh | max. Report agent runs deep research work and
# usually wants high or above; copilot is fine at medium (set per-agent in
# code, not here — this is only the fallback).
LLM_EFFORT=high

# ---------------------------------------------------------------------------
# DB (src/skr_agent/config/db.py) — placeholder, nothing uses this yet.
# ---------------------------------------------------------------------------
# DB_DSN=postgresql://user:pass@host:5432/dbname
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# MINIO (src/skr_agent/config/minio.py) — placeholder, nothing uses this yet.
# ---------------------------------------------------------------------------
# MINIO_ENDPOINT=api-minio-c2.digwork-test.ftest.tsmc.com
# MINIO_ACCESS_KEY=cpoml-object-storage-admin
# MINIO_SECRET_KEY=...
# MINIO_BUCKET_NAME=cpoml-object-storage
