# Copy to .env and fill in. Every IO service this codebase talks to is
# configured here — nothing else should need a code change to move from a
# laptop to the real company environment. See src/deep_research_agent/config/.

# ---------------------------------------------------------------------------
# LLM (src/deep_research_agent/config/llm.py) — which chat model the agent runs on.
# The agent runs on LangChain, so any provider with a LangChain chat model
# works; nothing here is tied to a particular vendor's wire protocol.
# ---------------------------------------------------------------------------

# "openrouter" (default) | "openai" | "anthropic" | "custom"
LLM_PROVIDER=openrouter

# --- provider=openrouter: simulating an internal host with OpenRouter ------
# 1. Get a key at https://openrouter.ai/keys — it looks like sk-or-v1-...
# 2. Set it here. LLM_BASE_URL and LLM_MODEL already default correctly for
#    this provider (openrouter.ai/api/v1 + qwen/qwen3.5-plus-02-15) — you
#    only need to set the key to get a working agent.
LLM_API_KEY=sk-or-v1-REPLACE_ME

# Optional: pick a different Qwen 3.5 tier. Flash is cheaper/faster, Plus is
# the stronger default above.
# LLM_MODEL=qwen/qwen3.5-flash-02-23

# --- provider=anthropic / openai: the vendor APIs directly ------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# (LLM_MODEL defaults per provider; override to pin a specific model.)

# --- provider=custom: an internal LLM gateway -------------------------------
# Anything exposing an OpenAI-compatible /v1/chat/completions works, which is
# what most internal gateways (vLLM, LiteLLM, a corporate proxy) expose.
# There is no default model for an unknown host, so LLM_MODEL is required.
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://llm.internal.corp/v1
# LLM_API_KEY=whatever-internal-auth-issues
# LLM_MODEL=whatever-the-internal-host-calls-its-model

# Sampling temperature. Research work wants reproducibility over variety.
# LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# LANGFUSE (src/deep_research_agent/config/langfuse.py) — step-by-step tracing.
#
# Off unless BOTH keys are set. One alone is treated as a misconfiguration and
# reported, not half-enabled.
#
# With it on, every run exports: each tool call with its arguments and result,
# each MCP call tagged with which server served it, each subagent delegation
# (the `task` call and the subagent's own nested span), token usage and
# per-step latency. The trace's Langfuse user is the triggering Principal, so
# a scheduled run and a user-triggered one are told apart by tag.
#
# Tracing can never fail a run: an unreachable host degrades to no tracing.
# ---------------------------------------------------------------------------
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_BASE_URL=http://langfuse-ai4bi.cpoap-dev.dev.tsmc.com   # this is the default
# LANGFUSE_ENVIRONMENT=dev      # optional: keeps dev traces out of prod's project

# ---------------------------------------------------------------------------
# SKILLS (src/deep_research_agent/config/skills.py) — rubrics the agent must
# follow on every run (report format, severity scale, house style).
#
# The built-in one ships in skills/. Use these only for a skill you
# maintain somewhere else — leaving both unset keeps today's behavior exactly.
#
# Directories that CONTAIN skill directories, colon-separated like PATH.
# Searched before this repo's skills/, so a shared skill can override
# a built-in of the same name.
# SKILLS_PATH=/opt/shared-skills:~/my-skills
#
# Extra skill names to load, comma-separated. ADDED to the agent's defaults,
# never replacing them — an env var that could silently drop the report rubric
# would be a footgun.
# SKILLS_ENABLED=house-style,supplier-tiering

# ---------------------------------------------------------------------------
# MCP (src/deep_research_agent/config/mcp.py) — external tool servers the agent may call.
#
# Entirely optional. With none of these set, the agent's tools are exactly the
# built-in ones and nothing tries to connect anywhere.
#
# Tools are discovered ONCE at startup, so a server that gains a tool later
# needs a restart to be noticed. A server that is unreachable at startup is
# logged and skipped — the agent still runs, just without those tools.
#
# NOTE ON IDENTITY: MCP_TOKEN is a connection-level service credential. The
# triggering user's Principal is NOT forwarded, so every call looks the same to
# the MCP server no matter who started the run. Only connect servers whose full
# contents the least-privileged caller of this agent may see.
# ---------------------------------------------------------------------------

# --- one server (the common case) ------------------------------------------
# MCP_URL=https://mcp.internal.corp/mcp
# MCP_TRANSPORT=streamable_http     # or: sse
# MCP_TOKEN=whatever-the-service-issues     # sent as Authorization: Bearer ...
# MCP_SERVER_NAME=internal          # label used in logs and citations
# MCP_TIMEOUT=60

# --- several servers, or a local stdio one ---------------------------------
# JSON, passed through to MultiServerMCPClient. Overrides MCP_URL entirely.
# MCP_SERVERS={"risk":{"transport":"streamable_http","url":"https://risk.internal/mcp"},"local":{"transport":"stdio","command":"python","args":["/path/to/server.py"]}}

# --- which MCP tools subagents may use --------------------------------------
# Nothing in the MCP protocol says whether a tool writes, so an arriving tool
# is undeclared -- and undeclared is treated as mutating. The effect is that an
# MCP tool is offered to the top-level agent and to NO subagent: not the
# researchers, not the reference checker. For a genuinely read-only tool that
# is a real loss, and this is where you say so.
#
#   lookup    read-only, fetches one named thing   -> anyone, checker included
#   search    read-only, finds things by query     -> researchers, not checker
#   mutating  changes state                        -> top-level agent only
#
# Key by tool name, or "server/tool" when two servers export the same name.
# Anything unlisted stays mutating. Declaring a tool read-only is a claim about
# someone else's service -- check what it does, do not go by its name.
# MCP_CAPABILITIES={"search_wiki_pages":"search","get_wiki_page":"lookup"}

# ---------------------------------------------------------------------------
# WIKI (src/deep_research_agent/config/wiki.py)
# ---------------------------------------------------------------------------
# Root for the links a report puts on its Sources line. The default is an
# obvious placeholder on purpose -- a link to a host nobody serves should be
# recognisable as unset at a glance. Routing itself is mocked in
# wiki/routes.py; that one function is what changes when the real shape is
# known.
# WIKI_BASE_URL=https://wiki.internal.corp/wiki

# ---------------------------------------------------------------------------
# PATHS (src/deep_research_agent/config/paths.py)
# ---------------------------------------------------------------------------
# Where skills and fixture data live. Both are found automatically from a
# source checkout, so you only need these when running from somewhere else --
# a container, or a cron entry with a different working directory.
# PATHS_PROJECT_ROOT=/app          # skills are looked up under <root>/skills/
# PATHS_FIXTURES=/app/fixtures     # defaults to <project_root>/fixtures

# ---------------------------------------------------------------------------
# DB (src/deep_research_agent/config/db.py) — placeholder, nothing uses this yet.
# ---------------------------------------------------------------------------
# DB_DSN=postgresql://user:pass@host:5432/dbname
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# ---------------------------------------------------------------------------
# MINIO (src/deep_research_agent/config/minio.py) — placeholder, nothing uses this yet.
# ---------------------------------------------------------------------------
# MINIO_ENDPOINT=api-minio-c2.digwork-test.ftest.tsmc.com
# MINIO_ACCESS_KEY=cpoml-object-storage-admin
# MINIO_SECRET_KEY=...
# MINIO_BUCKET_NAME=cpoml-object-storage
