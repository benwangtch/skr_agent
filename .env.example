# Copy to .env and fill in. Every IO service this codebase talks to is
# configured here — nothing else should need a code change to move from a
# laptop to the real company environment. See src/skr_agent/config/.

# ---------------------------------------------------------------------------
# LLM (src/skr_agent/config/llm.py) — which chat model the agent runs on.
# The agent runs on LangChain, so any provider with a LangChain chat model
# works; nothing here is tied to a particular vendor's wire protocol.
# ---------------------------------------------------------------------------

# "openrouter" (default) | "openai" | "anthropic" | "custom"
LLM_PROVIDER=openrouter

# --- provider=openrouter: simulating an internal host with OpenRouter ------
# 1. Get a key at https://openrouter.ai/keys — it looks like sk-or-v1-...
# 2. Set it here. LLM_BASE_URL and LLM_MODEL already default correctly for
#    this provider (openrouter.ai/api/v1 + qwen/qwen3.5-plus-02-15) — you
#    only need to set the key to get a working agent.
LLM_API_KEY=sk-or-v1-REPLACE_ME

# Optional: pick a different Qwen 3.5 tier. Flash is cheaper/faster, Plus is
# the stronger default above.
# LLM_MODEL=qwen/qwen3.5-flash-02-23

# --- provider=anthropic / openai: the vendor APIs directly ------------------
# LLM_PROVIDER=anthropic
# LLM_API_KEY=sk-ant-...
# (LLM_MODEL defaults per provider; override to pin a specific model.)

# --- provider=custom: an internal LLM gateway -------------------------------
# Anything exposing an OpenAI-compatible /v1/chat/completions works, which is
# what most internal gateways (vLLM, LiteLLM, a corporate proxy) expose.
# There is no default model for an unknown host, so LLM_MODEL is required.
# LLM_PROVIDER=custom
# LLM_BASE_URL=https://llm.internal.corp/v1
# LLM_API_KEY=whatever-internal-auth-issues
# LLM_MODEL=whatever-the-internal-host-calls-its-model

# Sampling temperature. Research work wants reproducibility over variety.
# LLM_TEMPERATURE=0.0

# ---------------------------------------------------------------------------
# DB (src/skr_agent/config/db.py) — placeholder, nothing uses this yet.
# ---------------------------------------------------------------------------
# DB_DSN=postgresql://user:pass@host:5432/dbname
# DB_POOL_MIN=1
# DB_POOL_MAX=10

# ---------------------------------------------------------------------------
